# .env.local нэрээр ХУУЛЖ аваад (зөөхгүй) Supabase төслийнхөө утгуудаар дүүргэнэ үү.
# Supabase Dashboard → Project Settings → API / Database

# --- Supabase API (Settings → API) ---
# Зөвхөн төслийн домэйн. Ард нь /rest/v1 гэх зам эсвэл ташуу зураас БИЧИХГҮЙ.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Зөвхөн сервер тал. RLS-ийг бүрэн тойрдог тул браузерт хэзээ ч гаргаж болохгүй,
# git-д commit хийхгүй. (seed скрипт болон админ үйлдэлд хэрэгтэй)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# --- Postgres (Settings → Database → Connection string) ---
# Нууц үгээ бичихдээ [YOUR-PASSWORD] дээрх дөрвөлжин хаалтыг ч БАС устгана.
# Апп ажиллах үеийн холболт: Transaction pooler (порт 6543)
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:PASSWORD@aws-1-eu-west-1.pooler.supabase.com:6543/postgres

# Migration-д зориулсан Session pooler (порт 5432).
# Pooler дээр DDL найдваргүй тул тусад нь заана.
DIRECT_URL=postgresql://postgres.xxxxxxxxxxxx:PASSWORD@aws-1-eu-west-1.pooler.supabase.com:5432/postgres

# --- Cloudinary (профайлын зураг) ---
# cloudinary.com → Dashboard → Product Environment Credentials
# Cloud нэр нь нууц биш — зургийн URL дотор гардаг тул NEXT_PUBLIC_.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=dxxxxxxxx
CLOUDINARY_API_KEY=123456789012345
# Зөвхөн сервер тал. Байршуулах, устгах эрх өгдөг тул браузерт гаргахгүй.
CLOUDINARY_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Админ ---
# Хянах самбар (/admin) нээх эрхтэй хэрэглэгчдийн id (таслалаар тусгаарлана).
# Хоосон бол /admin бүхэлдээ хэнд ч нээгдэхгүй (404).
ADMIN_USER_IDS=

# --- Апп ---
# Имэйл баталгаажуулах холбоос энэ хаяг руу буцаана. Мөн SEO-д ашиглагдана:
# canonical холбоос, sitemap.xml, OG зургийн хаяг бүгд эндээс үүсдэг тул
# production дээр заавал жинхэнэ домэйнээ (https://urtrag.com) бичнэ.
NEXT_PUBLIC_APP_URL=http://localhost:3000
