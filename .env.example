# .env.local нэрээр ХУУЛЖ аваад (зөөхгүй) Supabase төслийнхөө утгуудаар дүүргэнэ үү.
# Supabase Dashboard → Project Settings → API / Database

# --- Supabase API (Settings → API) ---
# Зөвхөн төслийн домэйн. Ард нь /rest/v1 гэх зам эсвэл ташуу зураас БИЧИХГҮЙ.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Зөвхөн сервер тал. RLS-ийг бүрэн тойрдог тул браузерт хэзээ ч гаргаж болохгүй,
# git-д commit хийхгүй. (seed скрипт болон админ үйлдэлд хэрэгтэй)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# --- Postgres (Settings → Database → Connection string) ---
# Нууц үгээ бичихдээ [YOUR-PASSWORD] дээрх дөрвөлжин хаалтыг ч БАС устгана.
# Апп ажиллах үеийн холболт: Transaction pooler (порт 6543)
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:PASSWORD@aws-1-eu-west-1.pooler.supabase.com:6543/postgres

# Migration-д зориулсан Session pooler (порт 5432).
# Pooler дээр DDL найдваргүй тул тусад нь заана.
DIRECT_URL=postgresql://postgres.xxxxxxxxxxxx:PASSWORD@aws-1-eu-west-1.pooler.supabase.com:5432/postgres

# --- Апп ---
# Имэйл баталгаажуулах холбоос энэ хаяг руу буцаана.
NEXT_PUBLIC_APP_URL=http://localhost:3000
